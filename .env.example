# ============================================================
# Epic Kiosk 环境变量配置文件
# ============================================================
# 复制此文件为 .env 并填写你的配置
# cp .env.example .env
# ============================================================

# OpenAI-compatible API Key（必须配置）
API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI-compatible API 地址
API_PROVIDER=openai_compatible
API_BASE_URL=https://api.example.com/v1

# 文本模型和视觉模型；验证码模型必须支持图片输入
PRIMARY_MODEL=your-text-model
PRIMARY_MODEL_FALLBACK=your-text-model
CAPTCHA_MODEL=your-vision-model
CAPTCHA_MODEL_FALLBACK=your-vision-model

# 验证码失败恢复策略
CAPTCHA_FAILURE_MAX_RETRIES=2
CAPTCHA_FAILURE_RETRY_DELAY_SECONDS=900
WARP_RESTART_COOLDOWN_SECONDS=300
TASK_SPACING_SECONDS=5
